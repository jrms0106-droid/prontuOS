{
  "name": "prontuos",
  "productName": "ProntuOS",
  "version": "1.0.0",
  "description": "Prontuário eletrônico instalável no computador, com dados salvos localmente.",
  "main": "main.js",
  "author": "ProntuOS",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "br.com.prontuos.app",
    "productName": "ProntuOS",
    "files": [
      "main.js",
      "preload.js",
      "storage.js",
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ProntuOS"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.medical"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "icon": "src/icone.png"
  }
}
